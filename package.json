{
	"name": "@ritsuki.kagerou/crt-ui",
	"version": "0.1.0",
	"type": "module",
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"files": [
		"dist"
	],
	"sideEffects": [
		"**/*.css"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./tokens.css": "./dist/tokens.css"
	},
	"peerDependencies": {
		"svelte": "^5.0.0"
	},
	"devDependencies": {
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/package": "^2.5.8",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@types/node": "^26.6.2",
		"jsdom": "^30.1.1",
		"prettier": "^3.9.9",
		"prettier-plugin-svelte": "^4.1.1",
		"publint": "^0.3.24",
		"svelte": "^5.57.0",
		"svelte-check": "^4.7.6",
		"typescript": "^6.0.3",
		"vite": "^8.3.0",
		"vitest": "^5.0.1"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"package": "svelte-kit sync && svelte-package && publint",
		"prepublishOnly": "pnpm package",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"test": "vitest run",
		"format": "prettier --write .",
		"lint": "prettier --check .",
		"test:ssr": "vitest run --project=ssr",
		"test:hydration": "vitest run --project=hydration",
		"check:app": "pnpm --filter crt-ui-ssr-app check"
	},
	"description": "CRT terminal components for Svelte 5 — SSR-safe, token-driven, reduced-motion aware.",
	"license": "MIT",
	"author": "Ritsuki <ritsuki.kagerou@gmail.com>",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ritsuki-kagerou/crt-ui.git"
	},
	"homepage": "https://github.com/ritsuki-kagerou/crt-ui#readme",
	"keywords": [
		"svelte",
		"svelte5",
		"crt",
		"terminal",
		"retro",
		"phosphor",
		"components"
	]
}
